{
  "name": "logo-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Logo Lab — browser-based logo, typography and construction studio",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "build": "node scripts/build-fonts.mjs && esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/logo-lab.js",
    "test": "node scripts/smoke-test.cjs"
  },
  "dependencies": {
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@fontsource/dm-serif-display": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/archivo-black": "^5.0.0",
    "@fontsource/jost": "^5.0.0",
    "@fontsource/bebas-neue": "^5.0.0",
    "@fontsource/cormorant-garamond": "^5.0.0"
  }
}
